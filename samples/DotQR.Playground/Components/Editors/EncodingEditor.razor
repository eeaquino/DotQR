<details class="encoding-panel" open>
    <summary>QR encoding</summary>
    <label for="qr-family">QR family</label>
    <select id="qr-family" value="@(Options.IsMicro ? "micro" : "standard")" @onchange="FamilyChanged">
        <option value="standard">Standard QR</option><option value="micro">Micro QR</option>
    </select>
    @if (Locked) { <p class="notice">This payment payload controls version, ECC, and ECI. Effective settings are shown with the preview.</p> }
    @if (BinaryPayment) { <p class="notice">Russian payments encode exact payload bytes in the selected character set. Version is automatic; UTF-8 and ECI controls do not apply.</p> }
    @if (Girocode) { <p class="notice">Girocode requires ECC M and its payload character set. UTF-8 / ISO-8859-1 / ISO-8859-2 support fixed QR versions; other sets use exact binary bytes with automatic version. Generic UTF-8/BOM/ECI controls do not apply.</p> }
    <fieldset disabled="@(Locked || BinaryPayment || GirocodeBinary)">
        <label for="qr-version">Version</label>
        <select id="qr-version" value="@Options.Version" @onchange="VersionChanged">
            @if (Options.IsMicro)
            {
                @for (var i = 1; i <= 4; i++) { <option value="@(-i)">M@i</option> }
            }
            else
            {
                <option value="-1">Automatic (smallest that fits)</option>
                @for (var i = 1; i <= 40; i++) { <option value="@i">@i</option> }
            }
        </select>
    </fieldset>
    <fieldset disabled="@(Locked || Girocode)">
        <label for="qr-ecc">Error correction</label>
        <select id="qr-ecc" value="@(Locked || Girocode ? QRCodeGenerator.ECCLevel.M : Options.EccLevel)" @onchange="EccChanged">
            @foreach (var level in EccChoices) { <option value="@level">@level</option> }
        </select>
    </fieldset>
    @if (Options.IsMicro)
    {
        <p class="help">M1: numeric only, detection only. M2: numeric / alphanumeric. M3–M4: limited byte capacity. Q is supported only in M4; H is never supported.</p>
    }
    else
    {
        <fieldset disabled="@(Locked || BinaryPayment || Girocode)">
            <label for="qr-eci">ECI mode</label>
            <select id="qr-eci" value="@Options.EciMode" @onchange="EciChanged">
                @foreach (var mode in Enum.GetValues<QRCodeGenerator.EciMode>()) { <option value="@mode">@mode</option> }
            </select>
            <label class="check"><input type="checkbox" checked="@Options.ForceUtf8" @onchange="Utf8Changed" /> Force UTF-8</label>
            <label class="check"><input type="checkbox" checked="@Options.Utf8Bom" @onchange="BomChanged" /> Include UTF-8 BOM</label>
        </fieldset>
    }
</details>

@code {
    [Parameter, EditorRequired] public EncodingOptions Options { get; set; } = default!;
    [Parameter] public bool Locked { get; set; }
    [Parameter] public bool BinaryPayment { get; set; }
    [Parameter] public bool Girocode { get; set; }
    [Parameter] public bool GirocodeBinary { get; set; }
    [Parameter] public EventCallback<EncodingOptions> Changed { get; set; }
    private IEnumerable<QRCodeGenerator.ECCLevel> EccChoices => !Options.IsMicro
        ? [QRCodeGenerator.ECCLevel.L, QRCodeGenerator.ECCLevel.M, QRCodeGenerator.ECCLevel.Q, QRCodeGenerator.ECCLevel.H]
        : Options.Version == -1 ? [QRCodeGenerator.ECCLevel.Default]
        : Options.Version == -4 ? [QRCodeGenerator.ECCLevel.L, QRCodeGenerator.ECCLevel.M, QRCodeGenerator.ECCLevel.Q]
        : [QRCodeGenerator.ECCLevel.L, QRCodeGenerator.ECCLevel.M];
    private Task FamilyChanged(ChangeEventArgs e) => Changed.InvokeAsync(new()
    {
        IsMicro = e.Value?.ToString() == "micro", Version = e.Value?.ToString() == "micro" ? -2 : -1,
        EccLevel = e.Value?.ToString() == "micro" ? QRCodeGenerator.ECCLevel.L : QRCodeGenerator.ECCLevel.M
    });
    private Task VersionChanged(ChangeEventArgs e)
    {
        var version = int.Parse(e.Value!.ToString()!, CultureInfo.InvariantCulture);
        var level = Options.EccLevel;
        if (Options.IsMicro)
        {
            if (version == -1) level = QRCodeGenerator.ECCLevel.Default;
            else if (level == QRCodeGenerator.ECCLevel.Default || (level == QRCodeGenerator.ECCLevel.Q && version != -4)) level = QRCodeGenerator.ECCLevel.L;
        }
        return Changed.InvokeAsync(Options with { Version = version, EccLevel = level });
    }
    private Task EccChanged(ChangeEventArgs e) => Changed.InvokeAsync(Options with { EccLevel = Enum.Parse<QRCodeGenerator.ECCLevel>(e.Value!.ToString()!) });
    private Task EciChanged(ChangeEventArgs e) => Changed.InvokeAsync(Options with { EciMode = Enum.Parse<QRCodeGenerator.EciMode>(e.Value!.ToString()!) });
    private Task Utf8Changed(ChangeEventArgs e) => Changed.InvokeAsync(Options with { ForceUtf8 = e.Value is true });
    private Task BomChanged(ChangeEventArgs e) => Changed.InvokeAsync(Options with { Utf8Bom = e.Value is true });
}

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Measurement harness, not a shipped artifact: analyzer rules about naming and disposability
         fight BenchmarkDotNet's design (static setup fields, underscore method names). -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/DotQR.Core/DotQR.Core.csproj" />
    <ProjectReference Include="../../src/DotQR.ByteRenderers/DotQR.ByteRenderers.csproj" />
    <ProjectReference Include="../../src/DotQR.SkiaSharp/DotQR.SkiaSharp.csproj" />
  </ItemGroup>

</Project>
